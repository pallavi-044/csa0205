void updateReservation(
    Reservation reservations[],
    int count
)
{
    int id;

    int index;

    int choice;


    id =
        readInt(
            "\nEnter Reservation ID: "
        );


    index =
        findReservationIndex(
            reservations,
            count,
            id
        );


    if (index == -1)
    {
        printf(
            "\nReservation not found.\n"
        );

        return;
    }


    if (
        strcmp(
            reservations[index].bookingStatus,
            "Cancelled"
        ) == 0
    )
    {
        printf(
            "\nCancelled reservation "
            "cannot be updated.\n"
        );

        return;
    }


    printf("\n1. Update Priority");
    printf("\n2. Update Seat Class");
    printf("\n3. Update Passenger Phone\n");


    choice =
        readInt(
            "Choice: "
        );


    if (choice == 1)
    {
        reservations[index].priority =
            readInt(
                "New priority (1-3): "
            );


        if (
            reservations[index].priority < 1 ||
            reservations[index].priority > 3
        )
        {
            reservations[index].priority = 3;

            printf(
                "Invalid priority. "
                "Normal priority selected.\n"
            );
        }
    }


    else if (choice == 2)
    {
        readLine(
            "New seat class: ",
            reservations[index].seatClass,
            sizeof(
                reservations[index].seatClass
            )
        );


        reservations[index].payment.totalAmount =
            calculateTicketCost(
                &reservations[index].flight,
                reservations[index].seatClass,
                reservations[index].priority
            );
    }


    else if (choice == 3)
    {
        readLine(
            "New phone: ",
            reservations[index]
                .passenger.contact.phone,
            sizeof(
                reservations[index]
                    .passenger.contact.phone
            )
        );
    }


    else
    {
        printf(
            "\nInvalid choice.\n"
        );

        return;
    }


    printf(
        "\nReservation updated successfully.\n"
    );
}


void cancelReservation(
    Reservation reservations[],
    int count,
    Flight flights[],
    int flightCount
)
{
    int id;

    int index;

    int flightIndex;


    id =
        readInt(
            "\nEnter Reservation ID: "
        );


    index =
        findReservationIndex(
            reservations,
            count,
            id
        );


    if (index == -1)
    {
        printf(
            "\nReservation not found.\n"
        );

        return;
    }


    if (
        strcmp(
            reservations[index].bookingStatus,
            "Cancelled"
        ) == 0
    )
    {
        printf(
            "\nReservation already cancelled.\n"
        );

        return;
    }


    strcpy(
        reservations[index].bookingStatus,
        "Cancelled"
    );


    strcpy(
        reservations[index].payment.paymentStatus,
        "Refund Pending"
    );


    flightIndex =
        findFlightIndex(
            flights,
            flightCount,
            reservations[index].flight.flightId
        );


    if (
        flightIndex != -1 &&
        flights[flightIndex].availableSeats <
        flights[flightIndex].totalSeats
    )
    {
        flights[flightIndex].availableSeats++;
    }


    printf(
        "\nReservation cancelled "
        "and seat released.\n"
    );
}


/* =========================
   SORTING
   ========================= */

void sortReservationsByPriority(
    Reservation reservations[],
    int count
)
{
    int i;

    int j;

    Reservation temp;


    for (i = 0; i < count - 1; i++)
    {
        for (
            j = 0;
            j < count - i - 1;
            j++
        )
        {
            if (
                reservations[j].priority >
                reservations[j + 1].priority
            )
            {
                temp =
                    reservations[j];

                reservations[j] =
                    reservations[j + 1];

                reservations[j + 1] =
                    temp;
            }

            else if (
                reservations[j].priority ==
                reservations[j + 1].priority &&
                reservations[j].reservationId >
                reservations[j + 1].reservationId
            )
            {
                temp =
                    reservations[j];

                reservations[j] =
                    reservations[j + 1];

                reservations[j + 1] =
                    temp;
            }
        }
    }
}


