void sortFlightsByFare(
    Flight flights[],
    int count
)
{
    int i;
    int j;

    Flight temp;


    for (i = 0; i < count - 1; i++)
    {
        for (
            j = 0;
            j < count - i - 1;
            j++
        )
        {
            if (
                flights[j].baseFare >
                flights[j + 1].baseFare
            )
            {
                temp =
                    flights[j];

                flights[j] =
                    flights[j + 1];

                flights[j + 1] =
                    temp;
            }
        }
    }
}


/* =========================
   RESERVATION
   ========================= */

void createReservation(
    Passenger passengers[],
    int passengerCount,
    Flight flights[],
    int flightCount,
    Reservation reservations[],
    int *reservationCount
)
{
    static int bookingCounter = 1000;

    int passengerId;

    int pIndex;

    int fIndex;

    char flightId[15];

    Reservation *r;


    if (
        *reservationCount >=
        MAX_RESERVATIONS
    )
    {
        printf(
            "\nReservation storage is full.\n"
        );

        return;
    }


    passengerId =
        readInt(
            "\nEnter Passenger ID: "
        );


    pIndex =
        findPassengerIndex(
            passengers,
            passengerCount,
            passengerId
        );


    if (pIndex == -1)
    {
        printf(
            "\nPassenger not found.\n"
        );

        return;
    }


    readLine(
        "Enter Flight ID: ",
        flightId,
        sizeof(flightId)
    );


    fIndex =
        findFlightIndex(
            flights,
            flightCount,
            flightId
        );


    if (fIndex == -1)
    {
        printf(
            "\nFlight not found.\n"
        );

        printf(
            "Please add the flight using option 4 first.\n"
        );

        return;
    }


    if (
        flights[fIndex].availableSeats <= 0
    )
    {
        printf(
            "\nNo seats available.\n"
        );

        return;
    }


    r =
        &reservations[*reservationCount];


    r->reservationId =
        ++bookingCounter;


    r->passenger =
        passengers[pIndex];


    r->flight =
        flights[fIndex];


    r->priority =
        readInt(
            "Priority "
            "(1 Emergency, 2 High, 3 Normal): "
        );


    if (
        r->priority < 1 ||
        r->priority > 3
    )
    {
        printf(
            "\nInvalid priority. "
            "Normal priority selected.\n"
        );

        r->priority = 3;
    }


    readLine(
        "Seat Class (Economy/Business/First): ",
        r->seatClass,
        sizeof(r->seatClass)
    );


    if (r->seatClass[0] == '\0')
    {
        strcpy(
            r->seatClass,
            "Economy"
        );
    }


    /*
       Allocate the next available seat.
    */

    r->seatNumber =
        flights[fIndex].totalSeats -
        flights[fIndex].availableSeats +
        1;


    strcpy(
        r->bookingStatus,
        "Confirmed"
    );


    r->bookingDate.day =
        readInt(
            "Booking Day: "
        );


    r->bookingDate.month =
        readInt(
            "Booking Month: "
        );


    r->bookingDate.year =
        readInt(
            "Booking Year: "
        );


    r->payment.baseAmount =
        flights[fIndex].baseFare;


    r->payment.totalAmount =
        calculateTicketCost(
            &flights[fIndex],
            r->seatClass,
            r->priority
        );


    r->payment.tax =
        r->payment.totalAmount *
        0.05f;


    r->payment.discount =
        0.0f;


    readLine(
        "Payment Mode (Cash/Card/UPI): ",
        r->payment.paymentMode,
        sizeof(r->payment.paymentMode)
    );


    readLine(
        "Payer/Card Holder: ",
        r->payment.cardHolder,
        sizeof(r->payment.cardHolder)
    );


    strcpy(
        r->payment.paymentStatus,
        "Paid"
    );


    flights[fIndex].availableSeats--;


    (*reservationCount)++;


    printf(
        "\nReservation created successfully.\n"
    );


    printf(
        "Reservation ID: %d\n",
        r->reservationId
    );


    printf(
        "Flight ID: %s\n",
        r->flight.flightId
    );


    printf(
        "Passenger: %s\n",
        r->passenger.name
    );


    printf(
        "Seat Number: %d\n",
        r->seatNumber
    );


    printf(
        "Total Fare: %.2f\n",
        r->payment.totalAmount
    );
}


