/* =========================
   MAIN
   ========================= */

int main(void)
{
    Passenger passengers[MAX_PASSENGERS];

    Flight flights[MAX_FLIGHTS];

    Reservation reservations[MAX_RESERVATIONS];

    int passengerCount = 0;
    int flightCount = 0;
    int reservationCount = 0;

    int choice;

    /*
       Load saved records when
       the program starts.
    */

    loadPassengers(
        passengers,
        &passengerCount
    );

    loadFlights(
        flights,
        &flightCount
    );

    loadReservations(
        reservations,
        &reservationCount
    );


    /*
       Main menu loop
    */

    do
    {
        mainMenu();

        choice = readInt(
            "Enter your choice: "
        );


        switch (choice)
        {
            case 1:

                addPassenger(
                    passengers,
                    &passengerCount
                );

                break;


            case 2:

                displayPassengers(
                    passengers,
                    passengerCount
                );

                break;


            case 3:

                searchPassenger(
                    passengers,
                    passengerCount
                );

                break;


            case 4:

                addFlight(
                    flights,
                    &flightCount
                );

                break;


            case 5:

                displayFlights(
                    flights,
                    flightCount
                );

                break;


            case 6:

                searchFlight(
                    flights,
                    flightCount
                );

                break;


            case 7:

                createReservation(
                    passengers,
                    passengerCount,
                    flights,
                    flightCount,
                    reservations,
                    &reservationCount
                );

                break;


            case 8:

                displayReservations(
                    reservations,
                    reservationCount
                );

                break;


            case 9:

                searchReservation(
                    reservations,
                    reservationCount
                );

                break;


            case 10:

                updateReservation(
                    reservations,
                    reservationCount
                );

                break;


            case 11:

                cancelReservation(
                    reservations,
                    reservationCount,
                    flights,
                    flightCount
                );

                break;


            case 12:

                sortReservationsByPriority(
                    reservations,
                    reservationCount
                );

                printf(
                    "\nReservations sorted by priority.\n"
                );

                displayReservations(
                    reservations,
                    reservationCount
                );

                break;


            case 13:

                sortFlightsByFare(
                    flights,
                    flightCount
                );

                printf(
                    "\nFlights sorted by fare.\n"
                );

                displayFlights(
                    flights,
                    flightCount
                );

                break;


            case 14:

                savePassengers(
                    passengers,
                    passengerCount
                );

                saveFlights(
                    flights,
                    flightCount
                );

                saveReservations(
                    reservations,
                    reservationCount
                );

                printf(
                    "\nAll records saved successfully.\n"
                );

                break;


            case 15:

                savePassengers(
                    passengers,
                    passengerCount
                );

                saveFlights(
                    flights,
                    flightCount
                );

                saveReservations(
                    reservations,
                    reservationCount
                );

                printf(
                    "\nRecords saved. Thank you.\n"
                );

                break;


            default:

                printf(
                    "\nInvalid choice."
                    " Please enter a number from 1 to 15.\n"
                );
        }

    } while (choice != 15);


    return 0;
}


