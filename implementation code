/* =========================
   FLIGHT
   ========================= */

void addFlight(
    Flight flights[],
    int *count
)
{
    int i;

    Flight *f;


    if (*count >= MAX_FLIGHTS)
    {
        printf(
            "\nFlight storage is full.\n"
        );

        return;
    }


    f = &flights[*count];


    readLine(
        "\nEnter Flight ID: ",
        f->flightId,
        sizeof(f->flightId)
    );


    if (f->flightId[0] == '\0')
    {
        printf(
            "\nFlight ID cannot be empty.\n"
        );

        return;
    }


    /*
       Check duplicate Flight ID
    */

    for (i = 0; i < *count; i++)
    {
        if (
            strcmp(
                flights[i].flightId,
                f->flightId
            ) == 0
        )
        {
            printf(
                "\nFlight ID already exists.\n"
            );

            return;
        }
    }


    readLine(
        "Enter Airline: ",
        f->airline,
        sizeof(f->airline)
    );


    readLine(
        "Enter Source: ",
        f->source,
        sizeof(f->source)
    );


    readLine(
        "Enter Destination: ",
        f->destination,
        sizeof(f->destination)
    );


    readLine(
        "Enter Type (Domestic/International): ",
        f->flightType,
        sizeof(f->flightType)
    );


    f->departureDate.day =
        readInt(
            "Enter Departure Day: "
        );


    f->departureDate.month =
        readInt(
            "Enter Departure Month: "
        );


    f->departureDate.year =
        readInt(
            "Enter Departure Year: "
        );


    if (
        f->departureDate.day < 1 ||
        f->departureDate.day > 31 ||
        f->departureDate.month < 1 ||
        f->departureDate.month > 12 ||
        f->departureDate.year < 1
    )
    {
        printf(
            "\nInvalid departure date.\n"
        );

        return;
    }


    readLine(
        "Enter Departure Time: ",
        f->departureTime,
        sizeof(f->departureTime)
    );


    f->totalSeats =
        readInt(
            "Enter Total Seats: "
        );


    if (f->totalSeats <= 0)
    {
        printf(
            "\nInvalid seat count.\n"
        );

        return;
    }


    f->availableSeats =
        f->totalSeats;


    f->baseFare =
        readFloat(
            "Enter Base Fare: "
        );


    if (f->baseFare <= 0.0f)
    {
        printf(
            "\nInvalid fare.\n"
        );

        return;
    }


    (*count)++;


    printf(
        "\nFlight added successfully.\n"
    );
}


