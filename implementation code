int findPassengerIndex(
    Passenger passengers[],
    int count,
    int id
)
{
    int i;


    for (i = 0; i < count; i++)
    {
        if (
            passengers[i].passengerId ==
            id
        )
        {
            return i;
        }
    }


    return -1;
}


