/* =========================
   TICKET COST
   ========================= */

float calculateTicketCost(
    const Flight *flight,
    const char seatClass[],
    int priority
)
{
    float amount;

    float classCharge = 0.0f;

    float priorityCharge = 0.0f;

    float tax;


    amount =
        flight->baseFare;


    /*
       Business = 50% extra
       First = 100% extra
    */

    if (
        strcmp(
            seatClass,
            "Business"
        ) == 0 ||
        strcmp(
            seatClass,
            "business"
        ) == 0
    )
    {
        classCharge =
            amount * 0.50f;
    }


    else if (
        strcmp(
            seatClass,
            "First"
        ) == 0 ||
        strcmp(
            seatClass,
            "first"
        ) == 0
    )
    {
        classCharge =
            amount;
    }


    /*
       Emergency = 10% extra
       High = 5% extra
    */

    if (priority == 1)
    {
        priorityCharge =
            amount * 0.10f;
    }

    else if (priority == 2)
    {
        priorityCharge =
            amount * 0.05f;
    }


    amount =
        amount +
        classCharge +
        priorityCharge;


    tax =
        amount * 0.05f;


    return amount + tax;
}


