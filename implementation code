/* =========================
   PASSENGER
   ========================= */

void addPassenger(
    Passenger passengers[],
    int *count
)
{
    int i;

    Passenger *p;


    if (*count >= MAX_PASSENGERS)
    {
        printf(
            "\nPassenger storage is full.\n"
        );

        return;
    }


    p = &passengers[*count];


    p->passengerId = readInt(
        "\nEnter Passenger ID: "
    );


    if (p->passengerId <= 0)
    {
        printf(
            "\nPassenger ID must be positive.\n"
        );

        return;
    }


    /*
       Check duplicate ID
    */

    for (i = 0; i < *count; i++)
    {
        if (
            passengers[i].passengerId ==
            p->passengerId
        )
        {
            printf(
                "\nPassenger ID already exists.\n"
            );

            return;
        }
    }


    readLine(
        "Enter passenger name: ",
        p->name,
        sizeof(p->name)
    );


    if (p->name[0] == '\0')
    {
        printf(
            "\nName cannot be empty.\n"
        );

        return;
    }


    p->age = readInt(
        "Enter age: "
    );


    if (
        p->age <= 0 ||
        p->age > 120
    )
    {
        printf(
            "\nInvalid age.\n"
        );

        return;
    }


    readLine(
        "Enter gender: ",
        p->gender,
        sizeof(p->gender)
    );


    readLine(
        "Enter nationality: ",
        p->nationality,
        sizeof(p->nationality)
    );


    readLine(
        "Enter phone: ",
        p->contact.phone,
        sizeof(p->contact.phone)
    );


    readLine(
        "Enter email: ",
        p->contact.email,
        sizeof(p->contact.email)
    );


    strcpy(
        p->contact.name,
        p->name
    );


    (*count)++;


    printf(
        "\nPassenger added successfully.\n"
    );
}


